# Kopiér denne fil til .env og udfyld egne passwords:  cp .env.example .env
# .env står i .gitignore og må aldrig committes (konstitution XII).
# Brug IKKE de gamle passwords (team_password / root_password) – de ligger i Git-historikken.

# MySQL (bruges af db-containeren og backend)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=project_db
MYSQL_USER=team_user
MYSQL_PASSWORD=change-me

# Backend
PORT=3000
